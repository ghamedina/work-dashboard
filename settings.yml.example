# ─── Jira ─────────────────────────────────────────────────────────────────────
# Connection settings for your Jira instance.
# Your API token and email go in .env — these are non-secret settings only.
jira:
  email: your.email@company.com            # Your Jira account email
  baseUrl: https://your-company.atlassian.net  # Jira cloud base URL
  projectKeys:
    - YOUR_PROJECT_KEY                     # Add one or more Jira project keys prefixes (REP, DSTM, etc)
    # - ANOTHER_KEY                        # Multiple keys are supported

# ─── GitLab ───────────────────────────────────────────────────────────────────
# Connection settings for your GitLab instance.
# Your token goes in .env — these are non-secret settings only.
gitlab:
  authorUsername: your.username            # Your GitLab username (filters MRs to yours)
  baseUrl: https://gitlab.your-company.com # GitLab base URL (self-hosted: https://gitlab.yourcompany.com)
  projectId: 0                             # Numeric project ID (found in project Settings → General)
  repo: your-org/your-repo                 # GitLab project path (org/repo-name)

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Optional: fetch GitHub PRs alongside GitLab MRs. List one entry per repo —
# PRs from all listed repos are fetched and shown together.
# Your token goes in .env as GITHUB_TOKEN (shared across all repos).
github:
  - owner: your-org                       # GitHub org or user who owns the repo
    repo: your-repo-name                  # Repository name (without org prefix)
    authorUsername: your-github-username  # GitHub username (filters PRs to yours)
  # - owner: your-org
  #   repo: another-repo
  #   authorUsername: your-github-username

# ─── Team ─────────────────────────────────────────────────────────────────────
# Optional: define team members to show work items for the whole team.
# If omitted, the dashboard shows only your own work (using the email and
# authorUsername fields above as a single implicit member).
#
# Each member can specify any combination of per-service identities:
#   jiraEmail            — Jira account email (used in assignee JQL filter)
#   gitlabAuthorUsername — GitLab username (filters MRs by author)
#   githubAuthorUsername — GitHub username (filters PRs by author)
#
# team:
#   - name: Alice
#     jiraEmail: alice@company.com
#     gitlabAuthorUsername: alice.gitlab
#     githubAuthorUsername: alice-gh
#   - name: Bob
#     jiraEmail: bob@company.com
#     gitlabAuthorUsername: bob.gitlab

# ─── My Manager tab ──────────────────────────────────────────────────────────
# Optional: define one or more teams you manage. The "My Manager" tab renders
# a Weekly Update card with one section per team. Each team can be either
# auto-pulled (Jira tickets + MRs/PRs for the current ISO week) or manual
# notes only.
#
# AUTO-PULL: set `jiraProjectKeys` AND list members with the relevant
# identities (jiraEmail for Jira, gitlabAuthorUsername for GitLab MRs,
# githubAuthorUsername for GitHub PRs).
#
# MANUAL ONLY: omit `jiraProjectKeys`. The section renders just a notes
# textarea (persisted in your browser's localStorage per ISO week).
#
# Omit this whole block to hide the tab.
#
# teams:
#   - name: Design System
#     jiraProjectKeys: [DSTM, GDSP]
#     members:
#       - name: Your Name
#         jiraEmail: you@company.com
#         gitlabAuthorUsername: your.username
#         githubAuthorUsername: your-gh
#       - name: Teammate
#         jiraEmail: teammate@company.com
#         gitlabAuthorUsername: teammate.gitlab
#   - name: Reporting
#     # no jiraProjectKeys, no members → manual notes only

# ─── Slack ────────────────────────────────────────────────────────────────────
# Optional: show a "Slack Todos" tab listing Slack messages you reacted to
# with a chosen emoji. Your token goes in .env as SLACK_TOKEN.
# Omit this whole block to hide the tab.
# slack:
#   workspaceSubdomain: acme               # used to build https://acme.slack.com/... links
#   emojiName: todo                        # bare emoji name, no colons
#   since: "2026-05-15"                    # ISO date; only items reacted to on/after this

# ─── Confluence ───────────────────────────────────────────────────────────────
# Optional: show a "Doc Reviews" tab listing Confluence pages you've starred.
# Reuses your Jira API token + email (same Atlassian basic auth).
# Omit this whole block to hide the tab.
# confluence:
#   baseUrl: https://your-company.atlassian.net/wiki
#   since: "2026-05-15"                    # ISO date; only pages starred on/after this

# ─── Amplitude ────────────────────────────────────────────────────────────────
# Amplitude Experiment Management API. Each project needs its own API key.
# API keys go in .env — only the project name and env var reference go here.
amplitude:
  baseUrl: https://experiment.amplitude.com/api/1
  orgSlug: your-amplitude-org-slug          # Found in your Amplitude dashboard URL
  # Each entry maps a project name to the env var holding its Management API key.
  # Find keys at: https://app.amplitude.com/experiment → Settings → API Keys (per project)
  projects:
    - name: your-project_development        # Human-readable project name (shown in the UI)
      envKey: AMPLITUDE_MANAGEMENT_KEY_DEV  # Env var name in .env holding the API key
    - name: your-project_production
      envKey: AMPLITUDE_MANAGEMENT_KEY_PROD

# ─── Claude Launcher ──────────────────────────────────────────────────────────
# Configures the "Open in Claude" button on each Jira row.
# Clicking it opens a new terminal window running `claude` in the selected repo,
# pre-loaded with a prompt that includes the Jira ticket details.
claudePrompt:
  default: basic                           # Which prompt to use by default (must match a key below)
  basePath: ~/                             # Base directory used when resolving path-type prompts

  prompts:
    # text-type: the prompt text is written directly here
    basic:
      type: text
      data: "Here is context for a Jira ticket I'm working on. Help me think through it."

    # Uncomment and customize to add more prompts.
    # They appear in a dropdown next to the "Open in Claude" button.

    # bugfix:
    #   type: text
    #   data: "Explore this bug in the codebase, identify the root cause, and make a plan for fixing it:"

    # explore:
    #   type: text
    #   data: "Explore this issue in the codebase and make a plan for implementing it:"

    # path-type: reads prompt text from a markdown file on disk.
    # $basePath is replaced with the basePath value above.
    # refactor:
    #   type: path
    #   data: $basePath/my-prompts/refactor-workflow.md

# ─── Repo Picker ──────────────────────────────────────────────────────────────
# Controls the repo dropdown in the Claude launcher.
# The selected path becomes the working directory for the `claude` command.
repoPath:
  default: ~/dev/my-project                # Pre-selected repo path when the picker opens

  repoPaths:
    - ~/dev/*                              # Glob: expands to all subdirectories in ~/dev/
    - ~/projects/specific-repo            # Literal path: adds a single repo directly
    # - ~/work/*                           # Add as many globs or literal paths as you like

# ─── Terminal ─────────────────────────────────────────────────────────────────
# Which terminal app to launch Claude in, and how to configure it.
# Supported: Terminal (macOS built-in), iTerm2, or Warp
terminal:
  terminalChoice: iTerm2                   # "Terminal", "iTerm2", or "Warp"

  terminalConfigs:
    Terminal:
      shell: zsh                           # Shell to run inside Terminal (zsh, bash, etc.)

    iTerm2:
      shell: zsh                           # Shell to run inside iTerm2
      profile: Default                     # iTerm2 profile name to use for the new window

    Warp:
      shell: zsh                           # Shell to run inside Warp (zsh, bash, etc.)
