# ─── Jira ────────────────────────────────────────────────────────────────────

# Jira API token (not your password).
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your_jira_api_token_here

# ─── GitLab ───────────────────────────────────────────────────────────────────
# GitLab personal access token with `read_api` scope (at minimum).
# Generate one at: https://gitlab.com/-/profile/personal_access_tokens
# (or replace the domain with your self-hosted GitLab instance)
GITLAB_TOKEN=your_gitlab_token_here

# ─── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token with `repo` scope (or `public_repo` for public repos).
# Generate one at: https://github.com/settings/tokens
# Required only if you configure a github section in settings.yml.
GITHUB_TOKEN=your_github_token_here

# ─── Amplitude ────────────────────────────────────────────────────────────────
# Amplitude Experiment Management API keys (one per project).
# Find them at: https://app.amplitude.com/experiment → Settings → API Keys
# Each project in settings.yml references an env var name via `envKey`.
AMPLITUDE_MANAGEMENT_KEY_DEV=your_amplitude_dev_key_here
AMPLITUDE_MANAGEMENT_KEY_PROD=your_amplitude_prod_key_here
